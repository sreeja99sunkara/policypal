# Allow-list: send only what the images need to the build context.
# Everything else (.env, venv/, .git/, data/, eval/, notebooks/, docs/,
# tests/, scripts/, notes/, caches) is excluded.
*
!Dockerfile
!requirements.txt
!docker/requirements-api.txt
!docker/requirements-ui.txt
!docker/start-demo.sh
!app/
!streamlit_app.py
# The one policy PDF the `demo` target indexes on startup (a public policy
# wording document). The rest of data/ - uploads, the Chroma index - stays out.
!data/raw/StarHealthAssureInsurancePolicy-Policy-wording.pdf

# never ship bytecode or secrets even inside allowed paths
**/__pycache__
**/*.pyc
**/.env
**/.env.*
